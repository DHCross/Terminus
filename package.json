    "sherlog:blast-radius": "node sherlog-velocity/src/cli/blast-radius.js",
    "sherlog:lint-plan": "node sherlog-velocity/src/cli/lint-plan.js",
    "sherlog:digest": "node sherlog-velocity/src/cli/digest.js",
    "sherlog:update": "node sherlog-velocity/src/cli/update.js",
    "sherlog:setup": "node sherlog-velocity/src/cli/setup.js",
    "sherlog:consumers": "node sherlog-velocity/src/cli/consumers.js",
    "sherlog:init-context": "node sherlog-velocity/src/cli/init-context.js",
