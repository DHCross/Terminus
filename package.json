    "sherlog:sonar": "node sherlog-velocity/src/cli/sonar.js",
    "sherlog:skills:suggest": "node sherlog-velocity/src/cli/skills.js --suggest",
    "sherlog:skills:generate": "node sherlog-velocity/src/cli/skills.js --generate",
    "sherlog:readiness": "node sherlog-velocity/src/cli/readiness.js",
    "sherlog:retrospective": "node sherlog-velocity/src/cli/retrospective.js",
    "sherlog:session:start": "node sherlog-velocity/src/cli/session.js start",
